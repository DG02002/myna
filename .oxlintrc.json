{
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".repos/**",
    ".roo/**",
    ".windsurf/**",
    "src/components/ui/**",
    "src/lib/resolve-class-name.ts",
    "src/routeTree.gen.ts",
    "tools/oxlint/anti-slop/**",
    "**/worker-configuration.d.ts"
  ],
  "jsPlugins": [
    {
      "name": "sonarjs",
      "specifier": "eslint-plugin-sonarjs"
    },
    {
      "name": "shadcn",
      "specifier": "@shadcn/lint"
    },
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    }
  ],
  "plugins": ["typescript", "unicorn", "react-hooks", "oxc", "import"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "overrides": [
    {
      // The Video.js skin source follows the registry's own conventions
      // (media-* utilities, arbitrary values, duplicated imports); the
      // shadcn design contracts govern application code only.
      "files": ["src/components/videojs/**"],
      "rules": {
        "no-duplicate-imports": "off",
        "no-shadow": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/no-raw-colors": "off",
        "shadcn/no-restyle": "off",
        "shadcn/no-unknown-classes": "off",
        "shadcn/require-static-classes": "off"
      }
    }
  ],
  "rules": {
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-restyle": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop-effect/no-manual-effect-error-tag": "error",
    "anti-slop-effect/no-manual-tag-comparison": "error",
    "anti-slop-effect/no-manual-tagged-construction": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "anti-slop-effect/prefer-effect-match": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-effect-dependencies": "warn",
    "react/set-state-in-effect": "warn",
    "react/memo-dependencies": "warn",
    "react/purity": "warn",
    "react/refs": "warn",
    "react/no-array-index-key": "warn",
    "react/use-memo": "warn",
    "react/globals": "warn",
    "react/jsx-no-useless-fragment": "warn",
    "react/no-react-children": "warn",
    "react/hook-use-state": "warn",
    "react/no-unescaped-entities": "warn",
    "unicorn/prefer-string-replace-all": "warn",
    "typescript/no-explicit-any": "error",
    "import/no-cycle": "error",
    "sonarjs/no-identical-functions": "warn",
    "import/no-unassigned-import": "off",
    // SAFETY comments are the repository's assertion gate; this rule would
    // repeat those approved assertions.
    "typescript/no-unsafe-type-assertion": "off",
    "no-promise-executor-return": "error",
    "eqeqeq": "warn",
    "no-var": "warn",
    "prefer-const": "warn",
    "curly": "warn",
    "no-eval": "warn",
    "no-implied-eval": "warn",
    "max-statements": [
      "warn",
      {
        "max": 20
      }
    ],
    "max-params": "warn",
    "no-nested-ternary": "warn",
    "no-extra-boolean-cast": "warn",
    "no-await-in-loop": "warn",
    "prefer-destructuring": "warn",
    "no-duplicate-imports": "warn",
    "no-useless-catch": "warn",
    "consistent-type-imports": "warn",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_tag", "__BUILD_TIME__"]
      }
    ],
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  }
}
