worker-configuration.d.ts

# Vendored read-only reference repos and agent scratch
.repos/
.plans/
.zcode/
temp/

# src/lib, scripts, and skill scripts are source code. A maintainer's global
# gitignore excluding [Ll]ib and [Ss]cripts silently dropped them before.
!src/lib/
!scripts/
!.agents/**/scripts/

# Dependency patches are source even when a global ignore excludes *.patch.
!patches/
!patches/*.patch
