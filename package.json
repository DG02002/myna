{
  "name": "playloom",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run lint:markdown && pnpm run typecheck && pnpm run knip && pnpm run knip:production",
    "lint": "oxlint src scripts vite.config.ts",
    "lint:markdown": "markdownlint-cli2",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit",
    "fmt": "oxfmt src scripts vite.config.ts package.json knip.json lint-staged.config.mjs .oxlintrc.json .oxfmtrc.json",
    "fmt:check": "oxfmt src scripts vite.config.ts package.json knip.json lint-staged.config.mjs .oxlintrc.json .oxfmtrc.json --check",
    "knip": "knip",
    "knip:production": "knip --production --include files,dependencies",
    "sync:repos": "tsx scripts/sync-repos.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.60",
    "@videojs/core": "10.0.1",
    "@videojs/react": "10.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "mediabunny": "^1.61.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@oxlint/plugins": "1.82.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "husky": "9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "17.5.1",
    "markdownlint-cli2": "^0.23.2",
    "oxfmt": "^0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.147.0"
  }
}
