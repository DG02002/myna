{
  "$schema": "./node_modules/knip.schema.json",
  "treatConfigHintsAsErrors": true,
  "entry": ["src/routes/**/*.{ts,tsx}!", "src/router.tsx!", "scripts/**/*.ts"],
  "project": [
    "src/**/*.{ts,tsx}!",
    "src/**/*.css!",
    "scripts/**/*.ts",
    "*.ts!"
  ],
  "ignoreIssues": {
    "src/components/ui/**/*.tsx": ["exports"]
  }
}
